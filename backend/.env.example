DATABASE_URL=postgresql+asyncpg://sensocrypt:sensocrypt@localhost:5434/sensocrypt
ANDROID_PACKAGE=com.sensocrypt
# Fill in after you generate your release signing cert:
#   keytool -list -v -keystore release.keystore | grep -A1 SHA-256
PINNED_SIGNING_CERT_DIGESTS_HEX=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PASETO_LOCAL_KEY_HEX=
# Full contents of the Firebase service-account JSON, as one line (paste the whole file).
FIREBASE_SERVICE_ACCOUNT_JSON=
